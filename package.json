    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.16.0",
    "eslint-config-next": "^15.5.18",
    "tsx": "^4.20.5",
    "typescript": "^5.7.0",
    "vitest": "^4.1.9"
  }
}
