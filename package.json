{
  "name": "multimix-web",
  "version": "0.1.0",
  "private": true,
  "overrides": {
    "postcss": "8.5.15"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:display-components": "vitest run app/assets/__tests__/display-area-readiness.test.tsx app/assets/__tests__/display-area-cases.test.tsx",
    "test:display-e2e": "node scripts/run-display-coverage.mjs --e2e-only",
    "test:display-coverage": "node scripts/run-display-coverage.mjs",
    "test:demo-units": "vitest run --config vitest.demo-e2e.config.ts && node --test scripts/__tests__/demo-e2e-*.test.mjs scripts/__tests__/run-demo-material-packs.test.mjs",
    "test:e2e:demo": "node scripts/run-demo-material-packs.mjs --mode stable --all",
    "test:e2e:demo:live": "node scripts/run-demo-material-packs.mjs --mode live",
    "test:e2e:pdf-video-quality": "node scripts/run-pdf-video-quality.mjs",
    "test:e2e:video-bgm": "node scripts/run-video-bgm-e2e.mjs",
    "test:e2e:video-pipeline-production": "node scripts/run-video-pipeline-production-e2e.mjs",
    "sync:agents": "node scripts/sync-agents-md.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "test:docs-check": "node --test scripts/__tests__/check-docs.test.mjs",
    "test:guardrails": "node --test scripts/__tests__/check-video-preview-contract.test.mjs scripts/__tests__/workspace-submit-guard.test.mjs",
    "check:video-preview-contract": "node scripts/check-video-preview-contract.mjs",
    "submit:guard": "node scripts/workspace-submit-guard.mjs",
    "test:product-stage-style": "node scripts/check-product-stage-style.mjs",
    "check:agents": "node scripts/sync-agents-md.mjs --check && npm run docs:check && npm run check:video-preview-contract",
    "check:backend": "cd ../MultiMix-Backend && .venv/Scripts/python -m ruff check --line-length 100 app/ && .venv/Scripts/python -m pytest app/tests/test_asset_conversation.py app/tests/test_video_orchestration.py app/tests/test_video_reliability.py app/tests/test_mg_render_flow.py app/tests/test_mg_scene_spec.py app/tests/test_mg_quality_reviewer.py app/tests/test_config.py app/tests/test_mcp_auth.py -q"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.2.2",
    "@hugeicons/react": "^1.1.9",
    "@huggingface/transformers": "^4.2.0",
    "@radix-ui/react-separator": "^1.1.10",
    "@supabase/supabase-js": "^2.106.1",
    "@tailwindcss/postcss": "^4.3.1",
    "@tailwindcss/typography": "^0.5.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "culori": "^4.0.2",
    "eventemitter3": "^5.0.4",
    "lucide-react": "0.487.0",
    "mediabunny": "1.50.8",
    "motion": "^12.42.0",
    "next": "^15.5.18",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.0",
    "react": "^19.0.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.80.0",
    "react-icons": "^5.6.0",
    "react-markdown": "^10.1.0",
    "react-window": "^2.2.7",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-parse": "^9.0.1",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "soundtouchjs": "^0.3.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.1",
    "tailwindcss-animate": "^1.0.7",
    "unified": "^11.0.5",
    "use-deep-compare-effect": "^1.8.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.16.0",
    "eslint-config-next": "^15.5.18",
    "jsdom": "^29.1.1",
    "tsx": "^4.20.5",
    "typescript": "^5.7.0",
    "vitest": "^4.1.9"
  }
}
