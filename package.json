{
  "name": "multimix-web",
  "version": "0.1.0",
  "private": true,
  "overrides": {
    "postcss": "8.5.15"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "setup:demo": "npm run db:init",
    "db:init": "node --import tsx scripts/db-init.ts",
    "test": "vitest run",
    "sync:agents": "node scripts/sync-agents-md.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "test:docs-check": "node --test scripts/__tests__/check-docs.test.mjs",
    "check:agents": "node scripts/sync-agents-md.mjs --check && npm run docs:check",
    "check:backend": "cd ../MultiMix-Backend && .venv/Scripts/python -m ruff check --line-length 100 app/ && .venv/Scripts/python -m pytest app/tests/test_asset_conversation.py app/tests/test_video_orchestration.py app/tests/test_video_reliability.py app/tests/test_mg_render_flow.py app/tests/test_mg_scene_spec.py app/tests/test_mg_quality_reviewer.py app/tests/test_config.py app/tests/test_mcp_auth.py -q"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.2.2",
    "@hugeicons/react": "^1.1.9",
    "@huggingface/transformers": "^4.2.0",
    "@radix-ui/react-separator": "^1.1.10",
    "@supabase/supabase-js": "^2.106.1",
    "@tailwindcss/postcss": "^4.3.1",
    "@tailwindcss/typography": "^0.5.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "culori": "^4.0.2",
    "eventemitter3": "^5.0.4",
    "lucide-react": "0.487.0",
    "mediabunny": "^1.49.0",
    "motion": "^12.42.0",
    "next": "^15.5.18",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.0",
    "react": "^19.0.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.80.0",
    "react-icons": "^5.6.0",
    "react-markdown": "^10.1.0",
    "react-window": "^2.2.7",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-parse": "^9.0.1",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "soundtouchjs": "^0.3.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.1",
    "tailwindcss-animate": "^1.0.7",
    "unified": "^11.0.5",
    "use-deep-compare-effect": "^1.8.1",
    "zustand": "^5.0.14"
